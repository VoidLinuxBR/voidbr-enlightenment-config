/*
 * Wallpaper VoidBR para o Enlightenment.
 * Compilado pelo build.sh a partir do papel de parede do voidbr-wallpapers:
 *   edje_cc -DIMG_FILE='"voidbr-wallpaper.avif"' -DIMG_W=<largura> -DIMG_H=<altura> \
 *           -id <dir> voidbr.edc voidbr.edj
 * A imagem cobre a tela inteira mantendo a proporção (como o "zoom" do GNOME).
 * Com -DLOGO_FILE='"voidbr.png"' (logo com transparência do voidbr-wallpapers),
 * a marca d'água do VoidBR vai no canto inferior direito.
 */
images {
   image: IMG_FILE LOSSY 92;
#ifdef LOGO_FILE
   image: LOGO_FILE COMP;
#endif
}
collections {
   group { name: "e/desktop/background";
      data {
         item: "style" "4";
         item: "noanimation" "1";
      }
      parts {
         part { name: "bg"; type: RECT; mouse_events: 0;
            description { state: "default" 0.0;
               color: 26 27 38 255; /* Tokyo Night #1a1b26 */
            }
         }
         part { name: "image"; type: IMAGE; mouse_events: 0;
            description { state: "default" 0.0;
               aspect: (IMG_W / IMG_H) (IMG_W / IMG_H);
               aspect_preference: NONE;
               image.normal: IMG_FILE;
            }
         }
#ifdef LOGO_FILE
         /* marca d'água: ~21% da largura da tela, perto do canto inferior direito */
         part { name: "logo"; type: IMAGE; mouse_events: 0;
            description { state: "default" 0.0;
               rel1.relative: 0.685 0.715;
               rel2.relative: 0.895 0.965;
               aspect: (640.0 / 426.0) (640.0 / 426.0);
               aspect_preference: BOTH;
               image.normal: LOGO_FILE;
               color: 255 255 255 230;
            }
         }
#endif
      }
   }
}
