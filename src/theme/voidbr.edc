/*
 * Tema complementar VoidBR para o Enlightenment.
 *
 * Só traz o que muda em relação ao tema padrão; o Elementary usa a lista
 * "voidbr:default" e procura cada grupo primeiro aqui e depois no default.
 *
 *   voidbr.edc        barra em ilha (estilo de shelf "voidbr")
 *   border.edc        bordas das janelas (barra fina, botões redondos, cantos)
 *   shell.edc         botão iniciar, áreas de trabalho em pílulas, popups,
 *                     menus e quadros do compositor
 *   notification.edc  notificações em cartão
 *   desklock.edc      tela de bloqueio (relógio grande e cartão de senha)
 *   central.edc       módulo voidbr (pílula de status, central de controle,
 *                     título da janela) e ícones do dock
 *
 * As cores seguem a paleta ativa (voidbr) pelo color_tree abaixo.
 *
 * Compilado pelo build.sh:  edje_cc -id src/theme voidbr.edc voidbr.edj
 */

data {
   item: "version" "119";
}

color_tree {
   ":bg-dim" {
      "/voidbr/panel";
   }
   ":selected-medium" {
      "/voidbr/lock/selection";
   }
   ":bg-darkest" {
      "/voidbr/lock/field";
   }
   ":bg-trans" {
      "/voidbr/lock/card";
   }
   ":fg-higher" {
      "/voidbr/lock/fg";
   }
   ":dim-light" {
      "/voidbr/lock/dim";
   }
   ":bg-semi" {
      "/voidbr/shelf/island";
   }
   ":bg-higher" {
      "/voidbr/dock/tile";
      "/voidbr/status/bg";
      "/voidbr/shelf/island/border";
   }
   ":bg-dark" {
      "/voidbr/win/bg";
      "/voidbr/accent/fg";
      "/voidbr/card/bg";
   }
   ":shadow" {
      "/voidbr/win/shadow";
   }
   ":dim" {
      "/voidbr/win/shadow/focused";
   }
   ":fg-dim" {
      "/voidbr/status/fg/dim";
      "/voidbr/win/title";
      "/voidbr/win/button/pressed";
      "/voidbr/pill/hover";
      "/voidbr/card/fg/dim";
   }
   ":fg" {
      "/voidbr/status/fg/title";
      "/voidbr/card/fg";
   }
   ":fg-high" {
      "/voidbr/status/fg";
      "/voidbr/lock/fg/dim";
      "/voidbr/win/title/focused";
      "/voidbr/card/fg/high";
   }
   ":selected-alt" {
      "/voidbr/status/urgent";
      "/voidbr/lock/hint";
      "/voidbr/win/title/urgent";
      "/voidbr/win/button/min";
   }
   ":bg-high" {
      "/voidbr/card/off";
      "/voidbr/win/button";
      "/voidbr/win/outline/focused";
      "/voidbr/card/line";
      "/voidbr/menu/hover";
   }
   ":bg-highest" {
      "/voidbr/dock/tile/hover";
      "/voidbr/status/bg/active";
      "/voidbr/card/hover";
      "/voidbr/lock/field/line";
      "/voidbr/win/button/focused";
      "/voidbr/pill";
   }
   ":selected" {
      "/voidbr/win/button/max";
      "/voidbr/accent";
   }
   ":selected-heavy" {
      "/voidbr/accent/active";
   }
   ":selected2" {
      "/voidbr/card/link";
   }
   ":selected4" {
      "/voidbr/status/low";
      "/voidbr/danger";
      "/voidbr/win/button/close";
      "/voidbr/card/close";
   }
   ":bg-medium" {
      "/voidbr/win/outline";
   }
}

images {
   image: "island.png" COMP;
   image: "island_border.png" COMP;
   image: "win_round.png" COMP;
   image: "win_line.png" COMP;
   image: "win_btn.png" COMP;
   image: "win_shadow.png" COMP;
   image: "start_v.png" COMP;
   image: "pill.png" COMP;
   image: "close_x.png" COMP;
   image: "ic_battery.png" COMP;
   image: "ic_bell_off.png" COMP;
   image: "ic_bluetooth.png" COMP;
   image: "ic_bolt.png" COMP;
   image: "ic_camera.png" COMP;
   image: "ic_gear.png" COMP;
   image: "ic_lock.png" COMP;
   image: "ic_moon.png" COMP;
   image: "ic_power.png" COMP;
   image: "ic_restart.png" COMP;
   image: "ic_sliders.png" COMP;
   image: "ic_sun.png" COMP;
   image: "ic_tiling.png" COMP;
   image: "ic_vol_high.png" COMP;
   image: "ic_vol_low.png" COMP;
   image: "ic_vol_mute.png" COMP;
   image: "ic_wifi.png" COMP;
   image: "ic_wifi_off.png" COMP;
}

efl_version: 1 26;

collections {
   /* GAP: distância da ilha até a borda da tela; PAD: espaço interno */
#define GAP 8
#define PAD 6

   group { name: "e/shelf/voidbr/base"; nomouse;
      data {
         /* a shelf não é retangular: o que fica fora da ilha é transparente */
         item: "shaped" "1";
         item: "noshadow" "1";
         item: "hidden_state_size" "2";
      }
      parts {
         rect { "mouse"; mouse;
            desc { color: 0 0 0 0; }
         }
         /* ilha: área desenhada, afastada GAP px da borda da tela */
         spacer { "island_area";
            scale: 1;
            desc { "default";
               rel1.offset: 0 0;
               rel2.offset: -1 (-1 - GAP);
               offscale;
            }
            desc { "top";
               rel1.offset: 0 GAP;
               rel2.offset: -1 -1;
               offscale;
            }
            desc { "left";
               rel1.offset: GAP 0;
               rel2.offset: -1 -1;
               offscale;
            }
            desc { "right";
               rel1.offset: 0 0;
               rel2.offset: (-1 - GAP) -1;
               offscale;
            }
         }
         image { "island"; nomouse;
            desc {
               rel.to: "island_area";
               image.normal: "island.png";
               image.border: 16 16 16 16;
               image.border_scale: 1;
               color_class: "/voidbr/shelf/island";
            }
         }
         image { "island_border"; nomouse;
            desc {
               rel.to: "island_area";
               image.normal: "island_border.png";
               image.border: 16 16 16 16;
               image.border_scale: 1;
               image.middle: NONE;
               color_class: "/voidbr/shelf/island/border";
            }
         }
         /* gadgets dentro da ilha, com PAD px de folga nas laterais */
         spacer { "sizer";
            scale: 1;
            desc { "default";
               rel.to: "island_area";
               rel1.offset: (PAD + 4) 2;
               rel2.offset: (-1 - PAD - 4) -3;
               offscale;
            }
            desc { "vert";
               rel.to: "island_area";
               rel1.offset: 2 (PAD + 4);
               rel2.offset: -3 (-1 - PAD - 4);
               offscale;
            }
         }
         part { name: "e.swallow.content"; type: SWALLOW; mouse;
            desc {
               rel.to: "sizer";
               link.base: "e,state,visible" "e";
            }
            desc { "hidden"; hid;
               rel.to: "sizer";
               link.base: "e,state,hidden" "e";
            }
         }
         rect { "events"; repeat; mouse;
            desc { color: 0 0 0 0; }
         }
      }
      programs {
#define ORIENT(_ORIENT, _AREA, _SIZER) \
         program { signal: "e,state,orientation,"_ORIENT; source: "e"; \
            action: STATE_SET _AREA 0.0; \
            target: "island_area"; \
            after: "sizer_"_ORIENT; \
         } \
         program { name: "sizer_"_ORIENT; \
            action: STATE_SET _SIZER 0.0; \
            target: "sizer"; \
         }
         ORIENT("top", "top", "default")
         ORIENT("top_left", "top", "default")
         ORIENT("top_right", "top", "default")
         ORIENT("bottom", "default", "default")
         ORIENT("bottom_left", "default", "default")
         ORIENT("bottom_right", "default", "default")
         ORIENT("left", "left", "vert")
         ORIENT("left_top", "left", "vert")
         ORIENT("left_bottom", "left", "vert")
         ORIENT("right", "right", "vert")
         ORIENT("right_top", "right", "vert")
         ORIENT("right_bottom", "right", "vert")
#undef ORIENT
      }
   }
#undef GAP
#undef PAD

#include "border.edc"
#include "shell.edc"
#include "notification.edc"
#include "desklock.edc"
#include "central.edc"
}
