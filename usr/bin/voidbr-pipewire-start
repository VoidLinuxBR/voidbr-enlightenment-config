#!/bin/sh
# voidbr-pipewire-start - inicia o PipeWire no login do Enlightenment
#  (pela lista de início ~/.e/e/applications/startup/.order; o E não roda
#   sozinho o ~/.config/autostart)
#  - no Void (runit) o pipewire, o wireplumber e o pipewire-pulse não terminam
#    no logout. No login seguinte o pipewire novo acha o socket ocupado e sai
#    com erro (o E mostra "PipeWire terminou inesperadamente"), e o que sobrou
#    da sessão anterior pode ficar sem o pipewire-pulse (apps sem som)
#  - por isso encerra as sobras deste usuário (e um PulseAudio que tenha
#    subido) e só então inicia o pipewire, que chama o wireplumber e o
#    pipewire-pulse pelos drop-ins de ~/.config/pipewire/pipewire.conf.d
#  - roda só na abertura da sessão: reiniciar o E não passa por aqui

uid=$(id -u)

# o pipewire-pulse aparece como "pipewire -c pipewire-pulse.conf"
pkill -u "$uid" -x pulseaudio 2>/dev/null
pkill -u "$uid" -x pipewire-pulse 2>/dev/null
pkill -u "$uid" -x wireplumber 2>/dev/null
pkill -u "$uid" -x pipewire 2>/dev/null

# espera até 2s terminarem; o que não terminar leva SIGKILL
i=0
while pgrep -u "$uid" -x 'pipewire|wireplumber|pipewire-pulse|pulseaudio' >/dev/null 2>&1; do
	i=$((i + 1))
	if [ "$i" -ge 20 ]; then
		pkill -9 -u "$uid" -x 'pipewire|wireplumber|pipewire-pulse|pulseaudio' 2>/dev/null
		sleep 0.2
		break
	fi
	sleep 0.1
done

exec pipewire
