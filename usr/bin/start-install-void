#!/bin/sh
# start-install-void - executado no login (via /etc/xdg/autostart)
#  - cria/atualiza as pastas do usuário (xdg-user-dirs)
#  - no live, coloca o atalho do instalador na Área de Trabalho

# LED do teclado
if [ -e "$HOME/.config/ledkeyboard" ] && command -v change-keyboard-led >/dev/null 2>&1; then
	change-keyboard-led on
fi

# Pastas do usuário (Área de trabalho, Documentos, ...)
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update

# Só no live
[ -e /run/initramfs/live/LiveOS/squashfs.img ] || exit 0

cfile='void-install.desktop'
src="/usr/share/applications/$cfile"
[ -f "$src" ] || exit 0

desktop_dir=$(xdg-user-dir DESKTOP 2>/dev/null)
[ -n "$desktop_dir" ] && [ "$desktop_dir" != "$HOME" ] || desktop_dir="$HOME/Desktop"
mkdir -p "$desktop_dir"

dest="$desktop_dir/$cfile"
cp -f "$src" "$dest"
chmod +x "$dest"
# marca o atalho como confiável nos gerenciadores de arquivos baseados em GIO
command -v gio >/dev/null 2>&1 && gio set "$dest" metadata::trusted true 2>/dev/null

exit 0
